# Every key the app reads. Copy to .env and fill in the values.
# Nothing in here may carry a VITE_ prefix: a VITE_ value is compiled into
# the browser bundle.

# .env (committed) - non-secret configuration
KOBOKU_PROVIDER_BASE_URL=http://127.0.0.1:8080/v1
KOBOKU_MODEL=qwen3.8-flash-next-iq3_xxs
KOBOKU_TEMPERATURE=0
KOBOKU_MAX_OUTPUT_TOKENS=4096
KOBOKU_WORKSPACE_DIR=workspace

# .env.local (git-ignored) - the key only. Copy it by hand, never print it.
KOBOKU_PROVIDER_API_KEY=
